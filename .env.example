# Database
POSTGRES_USER=dryclean
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=dryclean_content

# RabbitMQ
RABBITMQ_USER=dryclean
RABBITMQ_PASS=change_me_strong_password

# SSL
CERTBOT_EMAIL=admin@da-dryclean.ru

# Frontend
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_CONTENT_API_URL=/api/content
NEXT_PUBLIC_TRACKING_API_URL=

# Tracking Service
TRACKING_DATABASE_URL=postgresql+asyncpg://dryclean:change_me_strong_password@postgres:5432/dryclean_content
TRACKING_DATABASE_URL_SYNC=postgresql+psycopg2://dryclean:change_me_strong_password@postgres:5432/dryclean_content
TRACKING_RATE_LIMIT=100
TRACKING_CORS_ORIGINS=["https://da-dryclean.ru"]

# Grafana
GRAFANA_ADMIN_PASSWORD=change_me_strong_password
GRAFANA_BASIC_AUTH_USER=admin
GRAFANA_BASIC_AUTH_PASSWORD=change_me_separate_password

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PROXY_URL=

# VPS deploy (for CI/CD — set in GitHub Secrets, not here)
# VPS_HOST=
# VPS_USER=
# VPS_PORT=22
# SSH_PRIVATE_KEY=
# GITHUB_TOKEN=

# Central monitoring (metrics export via nginx 443, key stored only on VPS in /etc/nginx/conf.d/monitoring-key.conf)
# MONITORING_API_KEY — shared fallback key (ADR-010 violation, kept until per-site key is registered)
MONITORING_API_KEY=change_me_monitoring_key_from_spec
# SITE_METRICS_KEY — per-site key for da-dryclean.ru (ADR-010); generated on the VPS by
# scripts/setup-metrics-export.sh --generate-site-key, passed to the monitoring owner,
# never committed. Falls back to nothing: site works without it until generation.
SITE_METRICS_KEY=

# postgres_exporter (read-only user metrics_exporter, generated by scripts/setup-metrics-export.sh)
# Kept as fallback alongside app-level /metrics/postgres served by the content service.
POSTGRES_EXPORTER_PASSWORD=change_me_openssl_rand_hex_24
